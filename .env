# =============================================================
# DVSA PROJECT — Environment Variables
# Fill in the 5 values marked with TODO, then you're done.
# Everything else is pre-filled and should not change.
# =============================================================

# ------------------------------------------------------------------
# TODO 1: API Gateway URL
# How to find: AWS Console → API Gateway → your DVSA API → Stages
#              → click "Stage" → copy "Invoke URL" at the top
# Example:     https://ab12cd34ef.execute-api.us-east-1.amazonaws.com/Stage
# ------------------------------------------------------------------
API_URL="https://YOUR_API_ID.execute-api.us-east-1.amazonaws.com/Stage"

# ------------------------------------------------------------------
# TODO 2: AWS Account ID (12-digit number)
# How to find: AWS Console → click your username (top-right) → Account ID
# Example:     123456789012
# ------------------------------------------------------------------
ACCOUNT_ID="YOUR_12_DIGIT_ACCOUNT_ID"

# ------------------------------------------------------------------
# TODO 3: Cognito User Pool ID
# How to find: AWS Console → Cognito → User Pools → click your pool
#              → copy "User pool ID" from the overview tab
# Example:     us-east-1_AbCdEfGhI
# ------------------------------------------------------------------
USER_POOL_ID="us-east-1_XXXXXXXXX"

# ------------------------------------------------------------------
# TODO 4: JWT Tokens for 3 users (Admin, Attacker, Victim)
# How to find: Open the DVSA website → log in as User A
#              → open browser DevTools (F12) → Network tab
#              → click any request → look for "Authorization: Bearer eyJ..."
#              → copy the long token (everything AFTER "Bearer ")
#              Repeat for User B and User C.
# ------------------------------------------------------------------
TOKEN_A="PASTE_USER_A_JWT_TOKEN_HERE"
TOKEN_B="PASTE_USER_B_JWT_TOKEN_HERE"
TOKEN_C="PASTE_USER_C_JWT_TOKEN_HERE"

# ------------------------------------------------------------------
# TODO 5: S3 Receipts Bucket Name
# How to find: AWS Console → S3 → look for a bucket with "receipt" in name
#              OR run Lesson 4's exploit first — it will print the bucket name
# Example:     dvsa-receipts-us-east-1-123456789012
# ------------------------------------------------------------------
RECEIPTS_BUCKET="YOUR_RECEIPTS_BUCKET_NAME"

# ------------------------------------------------------------------
# TODO 6: DVSA Website URL
# How to find: AWS Console → CloudFormation → your DVSA stack
#              → Outputs tab → WebsiteURL value
#              OR: AWS Console → S3 → website bucket → Properties
#              → Static website hosting → copy the endpoint
# Example:     http://dvsa-website-123456789012.s3-website-us-east-1.amazonaws.com
# ------------------------------------------------------------------
WEBSITE_URL="http://YOUR_BUCKET_NAME.s3-website-us-east-1.amazonaws.com"

# =============================================================
# PRE-FILLED — Do not change these unless AWS renamed resources
# =============================================================

AWS_REGION="us-east-1"

# Lambda function names
FUNCTION_ORDER_MANAGER="DVSA-ORDER-MANAGER"
FUNCTION_RECEIPT_EMAIL="DVSA-SEND-RECEIPT-EMAIL"
FUNCTION_ADMIN_RECEIPT="DVSA-ADMIN-GET-RECEIPT"
FUNCTION_ADMIN_UPDATE="DVSA-ADMIN-UPDATE-ORDERS"

# DynamoDB table names
TABLE_ORDERS="DVSA-ORDERS-DB"
TABLE_USERS="DVSA-USERS-DB"

# CloudWatch log group
LOG_GROUP="/aws/lambda/DVSA-ORDER-MANAGER"

# Lesson 6 — DoS tuning
DOS_CONCURRENT_REQUESTS="50"
DOS_RATE_LIMIT="2.0"
DOS_BURST_LIMIT="5"

# Lesson 7 — IAM hardening
RESERVED_CONCURRENCY="10"
